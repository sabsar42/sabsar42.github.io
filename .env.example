# --- Agent (server only; never exposed to the browser) ---
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id. Keep it fast and inexpensive.
OPENROUTER_MODEL=openrouter/auto
# Optional: override the API base URL (e.g. a local mock for testing). Leave empty in production.
OPENROUTER_BASE_URL=

# --- Rate limiting (optional locally; required in production) ---
# Without these, an in-memory limiter is used (per server instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Messages per IP per hour
CHAT_RATE_LIMIT_PER_HOUR=20

# --- Site ---
# Canonical URL used for metadata, sitemap, robots and OG images.
NEXT_PUBLIC_SITE_URL=https://shakibabsar.vercel.app

# Native agent: messages per visitor per hour once OpenRouter is unavailable or a visitor's model budget is used.
NATIVE_RATE_LIMIT_PER_HOUR=60

# Open Channel (contact form): POST URL of your form backend (Formspree, Web3Forms, Getform, a webhook...).
# Messages are forwarded server-side as JSON. Leave empty until you have one; the form then offers email instead.
CONTACT_FORM_ENDPOINT=

# CORS: origins allowed to call /api from the browser (the GitHub Pages site). Comma-separated.
ALLOWED_ORIGINS=https://sabsar42.github.io

# Only for the GitHub Pages build (set as the repository variable API_BASE in GitHub Actions):
# the URL of this project's Vercel deployment, which hosts /api/chat, /api/agent/status and /api/contact.
NEXT_PUBLIC_API_BASE=
# Web3Forms access key (sent with each message; keep it server-side)
CONTACT_FORM_ACCESS_KEY=

# Browser-direct contact form (Web3Forms free plan only accepts browser requests; the key is public by design).
# Set at build time. On GitHub Pages, set these as repository VARIABLES.
NEXT_PUBLIC_CONTACT_ACCESS_KEY=
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
